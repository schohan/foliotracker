# Google AI / Gemini (required for ADK agents)
GOOGLE_API_KEY=

# Optional: override default model
FOLIOTRACKER_MODEL=gemini-2.0-flash

# Optional: persistence
MONGO_URI=

# Phase 0 local result cache (whole Phase0Result)
PHASE0_CACHE_TTL_SECONDS=3600
PHASE0_CACHE_DIR=.cache/foliotracker/phase0

# Phase 2C.1 — per-source cache + soft local rate budgets
SOURCE_CACHE_DIR=.cache/foliotracker/sources
YAHOO_SOURCE_TTL_SECONDS=3600
NEWS_SOURCE_TTL_SECONDS=900
SEC_SOURCE_TTL_SECONDS=3600
SEC_XBRL_SOURCE_TTL_SECONDS=86400
SOURCE_RATE_LIMIT_WINDOW_SECONDS=3600
YAHOO_RATE_LIMIT_CALLS=100
NEWS_RATE_LIMIT_CALLS=100
SEC_RATE_LIMIT_CALLS=30
SEC_XBRL_RATE_LIMIT_CALLS=20

# Yahoo Finance HTTP timeout (seconds)
YAHOO_TIMEOUT_SECONDS=15

# Google News RSS timeout (seconds) and max articles kept after dedupe
NEWS_TIMEOUT_SECONDS=15
NEWS_MAX_ARTICLES=5

# SEC EDGAR (set SEC_USER_AGENT to a real name + contact email per SEC fair access)
SEC_TIMEOUT_SECONDS=15
SEC_XBRL_TIMEOUT_SECONDS=30
SEC_MAX_FILINGS=5
SEC_USER_AGENT=FolioTracker contact@example.com

# Alpha Vantage (optional — forward P/E / market fill-gaps after Yahoo + SEC XBRL)
# Leave empty to disable the provider. Free tier ~25 calls/day.
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_SOURCE_TTL_SECONDS=86400
ALPHA_VANTAGE_RATE_LIMIT_CALLS=25
ALPHA_VANTAGE_RATE_LIMIT_WINDOW_SECONDS=86400
# Min seconds between live AV calls. Default = WINDOW/CALLS (~3456s) so
# bulk "Refresh all" cannot burn the daily quota in one burst. Set to 12
# for free-tier ~5/min pacing (still capped by CALLS/WINDOW). Set 0 to
# allow bursts within the call-count budget.
# ALPHA_VANTAGE_MIN_INTERVAL_SECONDS=
ALPHA_VANTAGE_TIMEOUT_SECONDS=20

# Watchlist dashboard (local JSON + CORS for Vite)
WATCHLIST_PATH=.cache/foliotracker/watchlist.json
WATCHLIST_CORS_ORIGINS=http://localhost:5173

# Daily Decision Brief (Slice 1)
BRIEF_STORE_PATH=.cache/foliotracker/briefs.json
BRIEF_MISS_LOG_PATH=.cache/foliotracker/brief_misses.jsonl
BRIEF_RING_SIZE=14
BRIEF_WINDOW_HOURS=24
BRIEF_MAX_TICKERS=15
BRIEF_MAX_BULLETS_PER_TICKER=5
BRIEF_GENERATE_BUDGET_SECONDS=60
BRIEF_MAX_WORKERS=6

# Insight provider: deterministic (default) | canned (staging UI) | llm (Gemini; fail-closed)
BRIEF_INSIGHT_MODE=deterministic

# Thesis page (T1–T5 — frameworks through OS Score + portfolio health)
THESIS_STORE_PATH=.cache/foliotracker/thesis.json
THESIS_RING_SIZE=14
THESIS_GENERATE_BUDGET_SECONDS=60
THESIS_MAX_WORKERS=6
# Insight provider for change narrative + advisor + research answers:
# deterministic (default) | canned (staging UI) | llm (Gemini; fail-closed)
THESIS_INSIGHT_MODE=deterministic
THESIS_SNAPSHOT_RING_SIZE=8
THESIS_QUARTER_DAYS=90

