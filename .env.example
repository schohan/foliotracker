# Google AI / Gemini (required for ADK agents)
GOOGLE_API_KEY=

# Optional: override default model
FOLIOTRACKER_MODEL=gemini-2.0-flash

# Optional: persistence
MONGO_URI=

# Phase 0 local result cache (whole Phase0Result)
PHASE0_CACHE_TTL_SECONDS=3600
PHASE0_CACHE_DIR=.cache/foliotracker/phase0

# Phase 2C.1 — per-source cache + soft local rate budgets
SOURCE_CACHE_DIR=.cache/foliotracker/sources
YAHOO_SOURCE_TTL_SECONDS=3600
NEWS_SOURCE_TTL_SECONDS=900
SEC_SOURCE_TTL_SECONDS=3600
SOURCE_RATE_LIMIT_WINDOW_SECONDS=3600
YAHOO_RATE_LIMIT_CALLS=100
NEWS_RATE_LIMIT_CALLS=100
SEC_RATE_LIMIT_CALLS=30

# Yahoo Finance HTTP timeout (seconds)
YAHOO_TIMEOUT_SECONDS=15

# Google News RSS timeout (seconds) and max articles kept after dedupe
NEWS_TIMEOUT_SECONDS=15
NEWS_MAX_ARTICLES=5

# SEC EDGAR (set SEC_USER_AGENT to a real name + contact email per SEC fair access)
SEC_TIMEOUT_SECONDS=15
SEC_MAX_FILINGS=5
SEC_USER_AGENT=FolioTracker contact@example.com
